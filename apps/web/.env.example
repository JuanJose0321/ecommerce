# Medusa backend (Store API)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Stripe (Fase 5) - solo la llave publicable va en el frontend.
# La llave secreta y el webhook secret viven UNICAMENTE en apps/backend/.env
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (Fase 7)
RESEND_API_KEY=
STORE_OWNER_EMAIL=

# Rate limiting (Fase 6, opcional con Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
